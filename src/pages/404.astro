---
import Layout from '@/layouts/Layout.astro';

// Emitted by the static build as dist/404.html. Cloudflare Pages serves that
// file with a real 404 status; without it, Pages falls back to index.html with
// HTTP 200, which turns every wrong URL into a soft 404 duplicating the
// homepage. That matters here because the 5-article taxonomy threshold
// deliberately removed several thousand /signals and /sources URLs.
---

<Layout
  seo={{
    title: 'Page Not Found',
    description: 'The page you requested does not exist on The Machine Herald.',
  }}
>
  <section class="container-reading py-20 text-center">
    <p
      class="text-xs font-mono uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark mb-3"
    >
      Error 404
    </p>

    <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight mb-4">
      Page not found
    </h1>

    <p class="text-lg text-text-secondary-light dark:text-text-secondary-dark mb-8">
      This page does not exist. It may have been removed, or the link that brought you
      here may be incomplete.
    </p>

    <!-- Populated only when the path looks like a retired taxonomy URL. -->
    <p
      id="taxonomy-hint"
      class="text-text-secondary-light dark:text-text-secondary-dark mb-8"
      hidden
    >
      Coverage of <span id="taxonomy-term" class="font-medium"></span> may still exist —
      only topics with five or more articles get their own page.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      <button
        type="button"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
        data-search-open
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
          />
        </svg>
        Search the archive
      </button>

      <a
        href="/"
        class="inline-flex items-center rounded-lg border border-border-light px-4 py-2 text-sm font-medium transition-colors hover:bg-zinc-100 dark:border-border-dark dark:hover:bg-zinc-800"
      >
        Go to the front page
      </a>
    </div>

    <nav
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-text-secondary-light dark:text-text-secondary-dark"
      aria-label="Suggested sections"
    >
      <a href="/articles" class="hover:text-accent transition-colors">All articles</a>
      <a href="/topics" class="hover:text-accent transition-colors">Topics</a>
      <a href="/signals" class="hover:text-accent transition-colors">Signals</a>
      <a href="/provenance" class="hover:text-accent transition-colors">Provenance</a>
    </nav>
  </section>
</Layout>

<script>
  // Most 404s here arrive at a retired /signals/<slug> or /sources/<domain>
  // URL, so we know what the visitor was after. Surface it and pre-fill the
  // search with it. Everything below is best-effort: if any piece is missing
  // the page still works as a plain 404.
  const match = window.location.pathname.match(/^\/(signals|sources)\/([^/]+)/);
  if (match) {
    const [, kind, raw] = match;
    const term = kind === 'sources' ? raw! : decodeURIComponent(raw!).replace(/-/g, ' ');

    const hint = document.getElementById('taxonomy-hint');
    const termEl = document.getElementById('taxonomy-term');
    if (hint && termEl) {
      termEl.textContent = `“${term}”`;
      hint.hidden = false;
    }

    // Pagefind renders its input lazily once the modal opens, so poll briefly
    // rather than assuming it exists at click time.
    const prefill = (attempts = 20) => {
      const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
      if (input) {
        input.value = term;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      if (attempts > 0) requestAnimationFrame(() => prefill(attempts - 1));
    };

    document
      .querySelector('[data-search-open]')
      ?.addEventListener('click', () => prefill(), { once: true });
  }
</script>
